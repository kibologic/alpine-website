import { SwissComponent } from '@swissjs/core';
import { Navbar } from '../components/Navbar.uix';
import { Footer } from '../components/Footer.uix';
import { WaitlistModal } from '../components/WaitlistModal.uix';

component FeaturesPage {
  state {
    let theme: string = 'light';
    let waitlistOpen: boolean = false;
  }

  _toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('alpine-theme', this.theme);
    this.scheduleUpdate();
  }

  _openWaitlist() {
    this.waitlistOpen = true;
    this.scheduleUpdate();
  }

  _closeWaitlist() {
    this.waitlistOpen = false;
    this.scheduleUpdate();
  }

  mounted() {
    const savedTheme = localStorage.getItem('alpine-theme') || 'light';
    this.theme = savedTheme;
    document.documentElement.setAttribute('data-theme', savedTheme);
  }

  _posFeatures() {
    return [
      { title: 'Offline-First POS', desc: 'Transactions process locally and sync automatically when connectivity is restored. Never lose a sale due to network issues.' },
      { title: 'Multi-Terminal', desc: 'Run unlimited POS terminals per location with centralized session management and real-time cross-till reconciliation.' },
      { title: 'Barcode & QR', desc: 'Built-in scanner support for barcode and QR code products. Add new products on the fly directly from the till.' },
      { title: 'Flexible Receipts', desc: 'Print, email, or SMS receipts. Customize receipt templates with your logo, tax details, and loyalty program info.' },
      { title: 'Split Payments', desc: 'Accept mixed payment methods in a single transaction — cash, card, mobile money, and store credit combined.' },
      { title: 'Void & Refund', desc: 'Manager-approved voids and full or partial refunds with automatic inventory restock and audit log entries.' },
    ];
  }

  _inventoryFeatures() {
    return [
      { title: 'Real-Time Sync', desc: 'Every stock movement across all branches updates in real time. No more end-of-day reconciliation surprises.' },
      { title: 'Auto Reorder', desc: 'Set minimum stock thresholds per product per location. Alpine automatically generates purchase orders when levels drop.' },
      { title: 'Batch CSV Import', desc: 'Import thousands of SKUs in seconds from Excel or CSV. Map columns interactively and preview before committing.' },
      { title: 'Cycle Counts', desc: 'Scheduled and ad-hoc cycle counting workflows with variance reporting and manager approval gates.' },
      { title: 'Stock Takes', desc: 'Full physical stock-take mode with count sheets, mobile scanning, and automatic adjustment journals.' },
      { title: 'Branch Transfers', desc: 'Request, approve, and receive inter-branch stock transfers with full chain-of-custody tracking.' },
    ];
  }

  _financeFeatures() {
    return [
      { title: 'Real-Time P&L', desc: 'Live profit and loss visibility at outlet, region, and group level with drill-down to individual transactions.' },
      { title: 'Multi-Currency', desc: 'Transact in local currencies with automatic exchange rate updates and consolidated group reporting in base currency.' },
      { title: 'Tax Compliance', desc: 'Configurable tax rules for VAT, GST, and region-specific levies. Automated tax return data exports.' },
      { title: 'Fiscal Devices', desc: 'Native integration with certified fiscal devices for ZIMRA, KRA, MRA, and other fiscal authority requirements.' },
      { title: 'Audit Trail', desc: 'Immutable, timestamped audit log for every financial event. Supports external auditor access with read-only roles.' },
    ];
  }

  _devFeatures() {
    return [
      { title: 'REST API', desc: 'Fully documented REST API with OpenAPI spec. Supports all Alpine entities: products, orders, customers, branches.' },
      { title: 'Webhooks', desc: 'Subscribe to real-time events for orders, stock changes, and user actions. Retry logic and delivery logs included.' },
      { title: 'SDK', desc: 'Official TypeScript SDK for rapid integration. Works in Node.js, browser, and edge runtimes.' },
      { title: 'Module Federation', desc: 'Extend Alpine with custom modules that integrate directly into the main shell using Module Federation architecture.' },
    ];
  }

  _featureCard(f: any) {
    return (
      <div key={f.title} style="background: var(--brand-bg-surface); border: 1px solid var(--brand-border); border-radius: 16px; padding: 28px; transition: all 0.2s ease;" onmouseover={(e: any) => { e.currentTarget.style.borderColor = 'var(--brand-green)'; e.currentTarget.style.transform = 'translateY(-3px)'; }} onmouseout={(e: any) => { e.currentTarget.style.borderColor = 'var(--brand-border)'; e.currentTarget.style.transform = 'translateY(0)'; }}>
        <h4 style="font-size: 15px; font-weight: 800; color: var(--brand-navy); margin-bottom: 9px; letter-spacing: -0.01em;">{f.title}</h4>
        <p style="font-size: 13px; color: var(--brand-text-body); line-height: 1.65;">{f.desc}</p>
      </div>
    );
  }

  _sectionHeader(label: string, title: string) {
    return (
      <div style="margin-bottom: 43px;">
        <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 11px;">{label}</span>
        <h2 style="font-size: clamp(22px, 3.5vw, 34px); font-weight: 800; color: var(--brand-navy); line-height: 1.1; letter-spacing: -0.03em;">{title}</h2>
      </div>
    );
  }

  render() {
    return (
      <div style="min-height: 100vh; display: flex; flex-direction: column;">
        <Navbar
          theme={this.theme}
          toggleTheme={() => this._toggleTheme()}
          openWaitlist={() => this._openWaitlist()}
          activeSection=""
          activePage="/features"
        />

        <main style="flex: 1;">
          {/* Page Hero */}
          <section style="padding: 90px 29px 72px; background: var(--brand-bg-page); text-align: center; position: relative; overflow: hidden;">
            <div style="max-width: 680px; margin: 0 auto; position: relative; z-index: 2;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">Features</span>
              <h1 style="font-size: clamp(34px, 5.5vw, 58px); font-weight: 900; color: var(--brand-navy); line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 22px;">Every tool your retail operation needs</h1>
              <p style="font-size: 17px; color: var(--brand-text-body); line-height: 1.6; max-width: 540px; margin: 0 auto 36px; font-weight: 450;">Alpine is purpose-built for modern retail. From the toughest offline conditions to multi-country enterprise deployments.</p>
              <button onclick={() => this._openWaitlist()} class="btn btn-primary">Join the Waitlist</button>
            </div>
            <div style="position: absolute; top: -120px; left: 50%; transform: translateX(-50%); width: 600px; height: 600px; background: radial-gradient(circle, rgba(45, 122, 58, 0.05) 0%, transparent 70%); pointer-events: none;"></div>
          </section>

          {/* POS Features */}
          <section style="padding: 72px 29px; background: var(--brand-bg-subtle);">
            <div style="max-width: 1080px; margin: 0 auto;">
              {this._sectionHeader('Point of Sale', 'A POS built for every environment')}
              <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px;">
                {this._posFeatures().map((f: any) => this._featureCard(f))}
              </div>
            </div>
          </section>

          {/* Inventory Features */}
          <section style="padding: 72px 29px; background: var(--brand-bg-page);">
            <div style="max-width: 1080px; margin: 0 auto;">
              {this._sectionHeader('Inventory', 'Stock management that scales with you')}
              <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px;">
                {this._inventoryFeatures().map((f: any) => this._featureCard(f))}
              </div>
            </div>
          </section>

          {/* Finance Features */}
          <section style="padding: 72px 29px; background: var(--brand-bg-subtle);">
            <div style="max-width: 1080px; margin: 0 auto;">
              {this._sectionHeader('Finance', 'Real financial visibility across every outlet')}
              <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px;">
                {this._financeFeatures().map((f: any) => this._featureCard(f))}
              </div>
            </div>
          </section>

          {/* Developer Features */}
          <section style="padding: 72px 29px; background: var(--brand-bg-page);">
            <div style="max-width: 1080px; margin: 0 auto;">
              {this._sectionHeader('Developer', 'Build on top of Alpine')}
              <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 18px;">
                {this._devFeatures().map((f: any) => this._featureCard(f))}
              </div>
            </div>
          </section>

          {/* CTA */}
          <section style="padding: 72px 29px; background: var(--brand-navy-dark); text-align: center;">
            <div style="max-width: 560px; margin: 0 auto;">
              <h2 style="font-size: clamp(26px, 4vw, 40px); font-weight: 900; color: #fff; line-height: 1.1; letter-spacing: -0.04em; margin-bottom: 18px;">Ready to see Alpine in action?</h2>
              <p style="font-size: 15px; color: #9ca3af; line-height: 1.6; margin-bottom: 32px;">Join over 1,200 retailers already on the waitlist for early access.</p>
              <button onclick={() => this._openWaitlist()} class="btn btn-primary">Join the Waitlist</button>
            </div>
          </section>
        </main>

        <Footer />

        <WaitlistModal
          isOpen={this.waitlistOpen}
          theme={this.theme}
          onClose={() => this._closeWaitlist()}
        />
      </div>
    );
  }
}
