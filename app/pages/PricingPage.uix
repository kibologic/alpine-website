import { SwissComponent } from '@swissjs/core';
import { Navbar } from '../components/Navbar.uix';
import { Footer } from '../components/Footer.uix';
import { WaitlistModal } from '../components/WaitlistModal.uix';

component PricingPage {
  state {
    let theme: string = 'light';
    let waitlistOpen: boolean = false;
    let openFaq: number = -1;
  }

  _toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('alpine-theme', this.theme);
    this.scheduleUpdate();
  }

  _openWaitlist() {
    this.waitlistOpen = true;
    this.scheduleUpdate();
  }

  _closeWaitlist() {
    this.waitlistOpen = false;
    this.scheduleUpdate();
  }

  _toggleFaq(index: number) {
    this.openFaq = this.openFaq === index ? -1 : index;
    this.scheduleUpdate();
  }

  mounted() {
    const savedTheme = localStorage.getItem('alpine-theme') || 'light';
    this.theme = savedTheme;
    document.documentElement.setAttribute('data-theme', savedTheme);
  }

  _plans() {
    return [
      {
        name: 'Free',
        price: 'Free',
        period: '',
        desc: 'For small shops and solo operators testing the waters.',
        features: ['3 Users', '300 Inventory Units', '1 POS Register', '100 Customers', '1 Outlet Location', '1 Device Binding'],
        highlight: false,
      },
      {
        name: 'Pro',
        price: 'MWK 32k',
        period: '/mo',
        desc: 'For growing retail businesses operating at scale.',
        features: ['15 Users', '3,000 Inventory Units', '5 POS Registers', '5,000 Customers', '3 Outlet Locations', '5 Device Bindings', 'Priority support', 'Basic Analytics'],
        highlight: true,
      },
      {
        name: 'Premium',
        price: 'MWK 45k',
        period: '/mo',
        desc: 'For high-volume operations scaling across regions.',
        features: ['25 Users', '20,000 Inventory Units', '10 POS (+ add-ons)', '50,000 Customers', '15 Outlet Locations', '15 Device Bindings', 'Audit Logs', 'API Rate Limits'],
        highlight: false,
      },
    ];
  }

  _faqs() {
    return [
      {
        q: 'Is offline mode included on all plans?',
        a: 'Yes. Offline POS mode is a core feature available on every plan including Free. Your transactions are stored locally and sync automatically when connectivity returns.',
      },
      {
        q: 'Can I switch plans anytime?',
        a: 'Absolutely. You can upgrade or downgrade your plan at any time from your account settings. Upgrades take effect immediately; downgrades apply at the end of your billing cycle.',
      },
      {
        q: 'What happens when I hit storage limits?',
        a: 'You\'ll receive a notification when you reach 80% of your plan limits. You can upgrade to a higher tier or purchase add-on capacity to expand specific limits without changing your base plan.',
      },
      {
        q: 'Are there setup fees?',
        a: 'None. There are no setup fees, implementation charges, or hidden costs. You pay only the monthly subscription for your plan.',
      },
      {
        q: 'Do you offer annual billing?',
        a: 'Annual billing with a discount is coming at general availability. Early waitlist members will receive a special founding-member annual rate. Join the waitlist to lock in your rate.',
      },
      {
        q: 'What currency is pricing in?',
        a: 'Pricing shown is in Malawian Kwacha (MWK) for the initial launch market. We will support billing in USD, KES, ZAR, and other regional currencies at general availability.',
      },
    ];
  }

  render() {
    return (
      <div style="min-height: 100vh; display: flex; flex-direction: column;">
        <Navbar
          theme={this.theme}
          toggleTheme={() => this._toggleTheme()}
          openWaitlist={() => this._openWaitlist()}
          activeSection=""
          activePage="/pricing"
        />

        <main style="flex: 1;">
          {/* Page Hero */}
          <section style="padding: 90px 29px 72px; background: var(--brand-bg-page); text-align: center;">
            <div style="max-width: 600px; margin: 0 auto;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">Pricing</span>
              <h1 style="font-size: clamp(32px, 5vw, 52px); font-weight: 900; color: var(--brand-navy); line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 18px;">Simple, transparent pricing</h1>
              <p style="font-size: 17px; color: var(--brand-text-body); line-height: 1.6; font-weight: 450;">No surprise fees. Pay per outlet, scale as you grow.</p>
            </div>
          </section>

          {/* Pricing Cards */}
          <section style="padding: 0 29px 72px; background: var(--brand-bg-page);">
            <div style="max-width: 960px; margin: 0 auto;">
              <div class="grid" style="grid-template-columns: repeat(3, 1fr); gap: 22px; margin-bottom: 29px;">
                {this._plans().map((plan: any) => (
                  <div key={plan.name} style={`background: ${plan.highlight ? (this.theme === 'dark' ? 'var(--brand-bg-surface)' : 'var(--brand-bg-inverse)') : 'var(--brand-bg-surface)'}; border: 2.2px solid ${plan.highlight ? (this.theme === 'dark' ? 'var(--brand-green)' : 'var(--brand-bg-inverse)') : 'var(--brand-border)'}; border-radius: 22px; padding: 36px; position: relative; transition: all 0.3s ease; box-shadow: ${plan.highlight ? 'var(--brand-shadow)' : 'var(--brand-shadow-sm)'};`} onmouseover={(e: any) => { e.currentTarget.style.transform = 'translateY(-7px)'; }} onmouseout={(e: any) => { e.currentTarget.style.transform = 'translateY(0)'; }}>
                    {plan.highlight ? <div style="position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--brand-green); color: #fff; font-size: 10px; font-weight: 800; padding: 5px 14px; border-radius: 899px; text-transform: uppercase; letter-spacing: 0.08em; z-index: 10; box-shadow: 0 4px 9px rgba(16, 185, 129, 0.3);">Most Popular</div> : null}
                    <div style={`font-size: 13px; font-weight: 800; color: ${plan.highlight && this.theme !== 'dark' ? 'rgba(255,255,255,0.6)' : 'var(--brand-text-muted)'}; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 11px;`}>{plan.name}</div>
                    <div style="display: flex; align-items: baseline; gap: 4px; margin-bottom: 7px; flex-wrap: wrap;">
                      <div style={`font-size: 30px; font-weight: 900; color: ${plan.highlight && this.theme !== 'dark' ? 'var(--brand-text-inverse)' : 'var(--brand-text-primary)'}; letter-spacing: -0.05em;`}>{plan.price}</div>
                      {plan.period ? <div style={`font-size: 13px; font-weight: 500; color: ${plan.highlight && this.theme !== 'dark' ? 'rgba(255,255,255,0.4)' : 'var(--brand-text-muted)'};`}>{plan.period}</div> : null}
                    </div>
                    <div style={`font-size: 14px; color: ${plan.highlight && this.theme !== 'dark' ? 'rgba(255,255,255,0.5)' : 'var(--brand-text-muted)'}; margin-bottom: 29px; line-height: 1.5; font-weight: 450;`}>{plan.desc}</div>
                    <div style="height: 1px; background: var(--brand-border); width: 100%; margin-bottom: 29px; opacity: 0.5;"></div>
                    <div style="display: flex; flex-direction: column; gap: 13px; margin-bottom: 36px;">
                      {plan.features.map((feature: string) => (
                        <div key={feature} style="display: flex; align-items: center; gap: 11px;">
                          <div style="width: 16px; height: 16px; border-radius: 50%; background: rgba(16, 185, 129, 0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <span style="font-size: 9px; color: var(--brand-green); font-weight: 900;">✓</span>
                          </div>
                          <span style={`font-size: 13px; color: ${plan.highlight && this.theme !== 'dark' ? 'var(--brand-text-inverse)' : 'var(--brand-text-primary)'}; font-weight: 450;`}>{feature}</span>
                        </div>
                      ))}
                    </div>
                    <button onclick={() => this._openWaitlist()} class="btn btn-ghost" style="width: 100%; border-radius: 899px;">Join Waitlist</button>
                  </div>
                ))}
              </div>

              {/* Enterprise tier */}
              <div style="background: var(--brand-bg-surface); border: 1.8px solid var(--brand-border); border-radius: 18px; padding: 22px 29px; display: flex; align-items: center; justify-content: space-between; gap: 29px; flex-wrap: wrap;">
                <div>
                  <div style="font-size: 12px; font-weight: 700; color: var(--brand-text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 4px;">Enterprise</div>
                  <div style="font-size: 13px; color: var(--brand-text-body); max-width: 500px; line-height: 1.5;">Remove all limits. Dedicated infrastructure, custom volume pricing, SLA guarantees, and 24/7 VIP support for massive deployments.</div>
                </div>
                <button onclick={() => this._openWaitlist()} style="white-space: nowrap; padding: 11px 29px; border-radius: 899px; border: 1.4px solid var(--brand-border); background: transparent; color: var(--brand-text-primary); font-size: 13px; font-weight: 600; cursor: pointer; transition: background 0.2s;" onmouseover={(e: any) => e.currentTarget.style.background = 'var(--brand-bg-subtle)'} onmouseout={(e: any) => e.currentTarget.style.background = 'transparent'}>Contact Sales</button>
              </div>
            </div>
          </section>

          {/* FAQ */}
          <section style="padding: 72px 29px; background: var(--brand-bg-subtle);">
            <div style="max-width: 720px; margin: 0 auto;">
              <div style="text-align: center; margin-bottom: 54px;">
                <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 14px;">FAQ</span>
                <h2 style="font-size: clamp(24px, 4vw, 38px); font-weight: 800; color: var(--brand-navy); line-height: 1.1; letter-spacing: -0.03em;">Frequently asked questions</h2>
              </div>

              <div style="display: flex; flex-direction: column; gap: 0;">
                {this._faqs().map((faq: any, i: number) => (
                  <div key={faq.q} style={`border-top: 1px solid var(--brand-border); ${i === this._faqs().length - 1 ? 'border-bottom: 1px solid var(--brand-border);' : ''}`}>
                    <button
                      onclick={() => this._toggleFaq(i)}
                      style="width: 100%; text-align: left; padding: 22px 0; background: none; border: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 18px;"
                    >
                      <span style="font-size: 15px; font-weight: 700; color: var(--brand-navy); line-height: 1.3;">{faq.q}</span>
                      <span style={`font-size: 20px; color: var(--brand-green); font-weight: 300; flex-shrink: 0; transition: transform 0.2s; transform: ${this.openFaq === i ? 'rotate(45deg)' : 'rotate(0deg)'};`}>+</span>
                    </button>
                    {this.openFaq === i ? (
                      <div style="padding-bottom: 22px;">
                        <p style="font-size: 14px; color: var(--brand-text-body); line-height: 1.7;">{faq.a}</p>
                      </div>
                    ) : null}
                  </div>
                ))}
              </div>
            </div>
          </section>
        </main>

        <Footer />

        <WaitlistModal
          isOpen={this.waitlistOpen}
          theme={this.theme}
          onClose={() => this._closeWaitlist()}
        />
      </div>
    );
  }
}
