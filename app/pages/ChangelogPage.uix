import { SwissComponent } from '@kibologic/core';
import { Navbar } from '../components/Navbar.uix';
import { Footer } from '../components/Footer.uix';
import { WaitlistModal } from '../components/WaitlistModal.uix';

component ChangelogPage {
  state {
    let theme: string = 'light';
    let waitlistOpen: boolean = false;
  }

  _toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('alpine-theme', this.theme);
    this.scheduleUpdate();
  }

  _openWaitlist() {
    this.waitlistOpen = true;
    this.scheduleUpdate();
  }

  _closeWaitlist() {
    this.waitlistOpen = false;
    this.scheduleUpdate();
  }

  mounted() {
    const savedTheme = localStorage.getItem('alpine-theme') || 'light';
    this.theme = savedTheme;
    document.documentElement.setAttribute('data-theme', savedTheme);
  }

  _entries() {
    return [
      {
        version: 'v0.1.0',
        date: 'May 2026',
        label: 'Initial Release',
        status: 'released',
        summary: 'The first public release of Alpine ERP. Core retail operations platform with multi-store support.',
        items: [
          { category: 'POS', desc: 'Full offline-capable point of sale with barcode scanning, split payments, void/refund, and receipt printing.' },
          { category: 'Inventory', desc: 'Real-time multi-store inventory tracking, stock transfers, cycle counts, and auto-reorder rules.' },
          { category: 'Multi-Store', desc: 'Centralized management for unlimited outlet locations with granular role-based permissions per branch.' },
          { category: 'Finance', desc: 'Real-time P&L, multi-currency support, tax configuration, and fiscal device integration framework.' },
          { category: 'User Management', desc: 'Role-based access control with custom roles, PIN-based till login, and session management.' },
          { category: 'REST API', desc: 'Full OpenAPI-spec REST API covering products, orders, customers, inventory, and reporting endpoints.' },
        ],
      },
      {
        version: 'Coming July 2026',
        date: 'July 2026',
        label: 'General Availability',
        status: 'upcoming',
        summary: 'Public launch with developer tooling, expanded fiscal compliance, and mobile experience.',
        items: [
          { category: 'Public Launch', desc: 'General availability with full onboarding flow, billing integration, and self-serve account management.' },
          { category: 'Developer SDK', desc: 'Official TypeScript SDK with typed models for all Alpine entities. Works in Node.js and browser environments.' },
          { category: 'Fiscal Adapter v2', desc: 'Expanded fiscal compliance with ZIMRA, KRA, MRA and new global e-invoicing standard support.' },
          { category: 'Mobile App', desc: 'Native iOS and Android app for inventory scanning, approval workflows, and real-time dashboard monitoring.' },
        ],
      },
    ];
  }

  render() {
    return (
      <div style="min-height: 100vh; display: flex; flex-direction: column;">
        <Navbar
          theme={this.theme}
          toggleTheme={() => this._toggleTheme()}
          openWaitlist={() => this._openWaitlist()}
          activeSection=""
          activePage="/changelog"
        />

        <main style="flex: 1;">
          {/* Page Hero */}
          <section style="padding: 90px 29px 72px; background: var(--brand-bg-page); text-align: center;">
            <div style="max-width: 600px; margin: 0 auto;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">Changelog</span>
              <h1 style="font-size: clamp(30px, 5vw, 50px); font-weight: 900; color: var(--brand-navy); line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 18px;">What's new in Alpine</h1>
              <p style="font-size: 16px; color: var(--brand-text-body); line-height: 1.6; font-weight: 450;">Release notes and upcoming changes. Follows semantic versioning.</p>
            </div>
          </section>

          {/* Timeline */}
          <section style="padding: 29px 29px 90px; background: var(--brand-bg-page);">
            <div style="max-width: 760px; margin: 0 auto;">
              {this._entries().map((entry: any, entryIndex: number) => (
                <div key={entry.version} style={`position: relative; padding-left: 43px; ${entryIndex < this._entries().length - 1 ? 'padding-bottom: 54px;' : ''}`}>
                  {/* Timeline line */}
                  {entryIndex < this._entries().length - 1 ? (
                    <div style="position: absolute; left: 13px; top: 36px; bottom: 0; width: 2px; background: var(--brand-border);"></div>
                  ) : null}

                  {/* Timeline dot */}
                  <div style={`position: absolute; left: 4px; top: 9px; width: 20px; height: 20px; border-radius: 50%; border: 2.5px solid ${entry.status === 'released' ? 'var(--brand-green)' : 'var(--brand-border)'}; background: ${entry.status === 'released' ? 'var(--brand-green)' : 'var(--brand-bg-page)'}; display: flex; align-items: center; justify-content: center;`}>
                    {entry.status === 'released' ? (
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    ) : (
                      <div style="width: 6px; height: 6px; border-radius: 50%; background: var(--brand-border);"></div>
                    )}
                  </div>

                  {/* Entry content */}
                  <div>
                    <div style="display: flex; align-items: center; gap: 11px; flex-wrap: wrap; margin-bottom: 5px;">
                      <span style="font-size: 20px; font-weight: 900; color: var(--brand-navy); letter-spacing: -0.03em;">{entry.version}</span>
                      <span style={`font-size: 10px; font-weight: 800; padding: 3px 10px; border-radius: 899px; text-transform: uppercase; letter-spacing: 0.08em; ${entry.status === 'released' ? 'background: rgba(45, 122, 58, 0.1); color: var(--brand-green);' : 'background: var(--brand-bg-subtle); color: var(--brand-text-muted); border: 1px solid var(--brand-border);'}`}>{entry.label}</span>
                    </div>
                    <div style="font-size: 12px; color: var(--brand-text-muted); font-weight: 600; margin-bottom: 14px;">{entry.date}</div>
                    <p style="font-size: 14px; color: var(--brand-text-body); line-height: 1.65; margin-bottom: 22px;">{entry.summary}</p>

                    <div style="display: flex; flex-direction: column; gap: 11px;">
                      {entry.items.map((item: any) => (
                        <div key={item.category} style="display: flex; align-items: flex-start; gap: 13px; background: var(--brand-bg-subtle); border: 1px solid var(--brand-border); border-radius: 12px; padding: 16px 18px;">
                          <span style="font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.06em; min-width: 90px; padding-top: 1px; flex-shrink: 0;">{item.category}</span>
                          <span style="font-size: 13px; color: var(--brand-text-body); line-height: 1.6;">{item.desc}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Subscribe CTA */}
          <section style="padding: 72px 29px; background: var(--brand-bg-subtle); border-top: 1px solid var(--brand-border);">
            <div style="max-width: 560px; margin: 0 auto; text-align: center;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">Stay Updated</span>
              <h2 style="font-size: clamp(22px, 3.5vw, 32px); font-weight: 900; color: var(--brand-navy); line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 14px;">Subscribe to release updates</h2>
              <p style="font-size: 15px; color: var(--brand-text-body); line-height: 1.6; margin-bottom: 29px;">Join the waitlist to receive release notifications and early access to new features when they ship.</p>
              <button onclick={() => this._openWaitlist()} class="btn btn-primary">Join the Waitlist</button>
            </div>
          </section>
        </main>

        <Footer />

        <WaitlistModal
          isOpen={this.waitlistOpen}
          theme={this.theme}
          onClose={() => this._closeWaitlist()}
        />
      </div>
    );
  }
}
