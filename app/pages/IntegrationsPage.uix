import { SwissComponent } from '@kibologic/core';
import { Navbar } from '../components/Navbar.uix';
import { Footer } from '../components/Footer.uix';
import { WaitlistModal } from '../components/WaitlistModal.uix';

component IntegrationsPage {
  state {
    let theme: string = 'light';
    let waitlistOpen: boolean = false;
  }

  _toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('alpine-theme', this.theme);
    this.scheduleUpdate();
  }

  _openWaitlist() {
    this.waitlistOpen = true;
    this.scheduleUpdate();
  }

  _closeWaitlist() {
    this.waitlistOpen = false;
    this.scheduleUpdate();
  }

  mounted() {
    const savedTheme = localStorage.getItem('alpine-theme') || 'light';
    this.theme = savedTheme;
    document.documentElement.setAttribute('data-theme', savedTheme);
  }

  _categories() {
    return [
      {
        label: 'Payments',
        icon: '💳',
        desc: 'Accept any payment method your customers prefer, from global cards to local mobile money.',
        items: [
          { name: 'Visa / Mastercard', detail: 'Full card-present and card-not-present flows via certified payment terminals.' },
          { name: 'Stripe', detail: 'Programmatic payment processing with automatic reconciliation to Alpine Finance.' },
          { name: 'PayPal', detail: 'QR-based and link-based PayPal checkout at the point of sale.' },
          { name: 'Adyen', detail: 'Enterprise-grade acquiring for high-volume merchants across multiple geographies.' },
          { name: 'Apple Pay', detail: 'Contactless NFC payments via iPhone and Apple Watch at the till.' },
          { name: 'M-Pesa', detail: 'USSD and STK-push mobile money payments for East and Southern African markets.' },
        ],
      },
      {
        label: 'Accounting',
        icon: '📊',
        desc: 'Sync your sales, costs, and inventory movements directly into your accounting platform.',
        items: [
          { name: 'QuickBooks', detail: 'Automatic journal entries, invoice sync, and chart-of-accounts mapping.' },
          { name: 'Sage', detail: 'Bi-directional sync for Sage 50, Sage 200, and Sage Intacct product lines.' },
          { name: 'Xero', detail: 'Real-time transaction posting with bank reconciliation and contact sync.' },
          { name: 'Alpine Finance', detail: 'Native Alpine Finance integration — zero-configuration, always in sync.' },
        ],
      },
      {
        label: 'Fiscal Compliance',
        icon: '🏛️',
        desc: 'Meet your local fiscal and tax authority requirements out of the box.',
        items: [
          { name: 'ZIMRA', detail: 'Zimbabwe Revenue Authority certified fiscal device integration for VAT compliance.' },
          { name: 'KRA', detail: 'Kenya Revenue Authority eTIMS integration for electronic tax invoice generation.' },
          { name: 'MRA', detail: 'Malawi Revenue Authority VSDC-compatible fiscal receipting and reporting.' },
          { name: 'Global E-Invoicing', detail: 'PEPPOL, Factur-X, and UBL-based e-invoicing for European and international markets.' },
        ],
      },
      {
        label: 'Operations',
        icon: '⚙️',
        desc: 'Connect your supply chain, external tools, and custom systems to Alpine.',
        items: [
          { name: 'Supplier EDI', detail: 'EDIFACT and X12 EDI for automated purchase orders and supplier confirmations.' },
          { name: 'Excel / CSV', detail: 'Bulk import and export for products, customers, stock counts, and transaction history.' },
          { name: 'REST API', detail: 'Fully documented OpenAPI-spec REST API covering all Alpine entities and operations.' },
          { name: 'Webhooks', detail: 'Real-time event delivery for orders, stock changes, user activity, and system events.' },
        ],
      },
    ];
  }

  render() {
    return (
      <div style="min-height: 100vh; display: flex; flex-direction: column;">
        <Navbar
          theme={this.theme}
          toggleTheme={() => this._toggleTheme()}
          openWaitlist={() => this._openWaitlist()}
          activeSection=""
          activePage="/integrations"
        />

        <main style="flex: 1;">
          {/* Page Hero */}
          <section style="padding: 90px 29px 72px; background: var(--brand-bg-page); text-align: center; position: relative; overflow: hidden;">
            <div style="max-width: 640px; margin: 0 auto; position: relative; z-index: 2;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">Integrations</span>
              <h1 style="font-size: clamp(32px, 5vw, 54px); font-weight: 900; color: var(--brand-navy); line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 22px;">Connects to your entire stack</h1>
              <p style="font-size: 17px; color: var(--brand-text-body); line-height: 1.6; font-weight: 450; max-width: 520px; margin: 0 auto;">Alpine plays well with the tools you already rely on — from payment gateways to compliance systems and accounting platforms.</p>
            </div>
            <div style="position: absolute; top: -90px; left: 50%; transform: translateX(-50%); width: 700px; height: 500px; background: radial-gradient(circle, rgba(45, 122, 58, 0.04) 0%, transparent 70%); pointer-events: none;"></div>
          </section>

          {/* Integration Categories */}
          <section style="padding: 54px 29px 72px; background: var(--brand-bg-subtle);">
            <div style="max-width: 1080px; margin: 0 auto; display: flex; flex-direction: column; gap: 54px;">
              {this._categories().map((cat: any) => (
                <div key={cat.label}>
                  <div style="display: flex; align-items: flex-start; gap: 18px; margin-bottom: 29px;">
                    <div style="width: 48px; height: 48px; background: var(--brand-bg-surface); border: 1px solid var(--brand-border); border-radius: 13px; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0;">{cat.icon}</div>
                    <div>
                      <h2 style="font-size: 22px; font-weight: 800; color: var(--brand-navy); letter-spacing: -0.02em; margin-bottom: 5px;">{cat.label}</h2>
                      <p style="font-size: 14px; color: var(--brand-text-muted); line-height: 1.5;">{cat.desc}</p>
                    </div>
                  </div>
                  <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px;">
                    {cat.items.map((item: any) => (
                      <div key={item.name} style="background: var(--brand-bg-surface); border: 1px solid var(--brand-border); border-radius: 13px; padding: 22px; transition: all 0.2s;" onmouseover={(e: any) => { e.currentTarget.style.borderColor = 'var(--brand-green)'; e.currentTarget.style.transform = 'translateY(-2px)'; }} onmouseout={(e: any) => { e.currentTarget.style.borderColor = 'var(--brand-border)'; e.currentTarget.style.transform = 'translateY(0)'; }}>
                        <div style="display: flex; align-items: center; gap: 9px; margin-bottom: 9px;">
                          <div style="width: 7px; height: 7px; border-radius: 50%; background: var(--brand-green); flex-shrink: 0;"></div>
                          <span style="font-size: 14px; font-weight: 700; color: var(--brand-navy);">{item.name}</span>
                        </div>
                        <p style="font-size: 12px; color: var(--brand-text-body); line-height: 1.6;">{item.detail}</p>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Build Your Own CTA */}
          <section style="padding: 72px 29px; background: var(--brand-bg-page);">
            <div style="max-width: 820px; margin: 0 auto; background: var(--brand-navy-dark); border-radius: 22px; padding: 54px; text-align: center;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">For Developers</span>
              <h2 style="font-size: clamp(24px, 4vw, 38px); font-weight: 900; color: #fff; line-height: 1.1; letter-spacing: -0.04em; margin-bottom: 18px;">Build your own integration</h2>
              <p style="font-size: 15px; color: #9ca3af; line-height: 1.6; max-width: 500px; margin: 0 auto 36px;">Alpine's REST API covers every entity in the platform. Build custom integrations, automate workflows, or embed Alpine data into your own apps.</p>
              <div style="display: flex; align-items: center; justify-content: center; gap: 14px; flex-wrap: wrap;">
                <a href="https://github.com/kibologic/alpine-website" target="_blank" style="display: inline-flex; align-items: center; gap: 9px; padding: 13px 29px; background: var(--brand-green); color: #fff; border-radius: 899px; font-size: 13px; font-weight: 700; text-decoration: none; transition: all 0.2s;" onmouseover={(e: any) => { e.currentTarget.style.background = 'var(--brand-green-light)'; e.currentTarget.style.transform = 'translateY(-1px)'; }} onmouseout={(e: any) => { e.currentTarget.style.background = 'var(--brand-green)'; e.currentTarget.style.transform = 'translateY(0)'; }}>View API Reference →</a>
                <button onclick={() => this._openWaitlist()} style="padding: 13px 29px; border-radius: 899px; border: 1px solid rgba(255,255,255,0.15); background: transparent; color: #fff; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s;" onmouseover={(e: any) => { e.currentTarget.style.background = 'rgba(255,255,255,0.07)'; }} onmouseout={(e: any) => { e.currentTarget.style.background = 'transparent'; }}>Join Waitlist for API Access</button>
              </div>
            </div>
          </section>
        </main>

        <Footer />

        <WaitlistModal
          isOpen={this.waitlistOpen}
          theme={this.theme}
          onClose={() => this._closeWaitlist()}
        />
      </div>
    );
  }
}
