import { Navbar } from '../components/Navbar.uix';
import { Footer } from '../components/Footer.uix';
import { WaitlistModal } from '../components/WaitlistModal.uix';

export default component AboutPage {
  state {
    let theme: string = 'light';
    let waitlistOpen: boolean = false;
  }

  _toggleTheme() {
    this.theme = this.theme === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', this.theme);
    localStorage.setItem('alpine-theme', this.theme);
    this.scheduleUpdate();
  }

  _openWaitlist() {
    this.waitlistOpen = true;
    this.scheduleUpdate();
  }

  _closeWaitlist() {
    this.waitlistOpen = false;
    this.scheduleUpdate();
  }

  mounted() {
    const savedTheme = localStorage.getItem('alpine-theme') || 'light';
    this.theme = savedTheme;
    document.documentElement.setAttribute('data-theme', savedTheme);
  }

  _values() {
    return [
      {
        title: 'Reliability over features',
        desc: 'We ship things that work offline, handle edge cases, and never lose a transaction. A feature that crashes under pressure is worse than no feature at all.',
      },
      {
        title: 'Works offline',
        desc: 'Connectivity in retail environments is not guaranteed. Alpine is architected from the ground up to function fully offline and sync transparently when connection is restored.',
      },
      {
        title: 'Open core model',
        desc: "Alpine's core — POS, inventory, and team management — is free forever. We make money on enterprise extensions, support, and managed cloud hosting, not by locking basic functionality.",
      },
    ];
  }

  _stats() {
    return [
      { stat: '2026', label: 'Founded' },
      { stat: 'Global', label: 'Availability' },
      { stat: 'Open Core', label: 'Business Model' },
    ];
  }

  render() {
    return (
      <div style="min-height: 100vh; display: flex; flex-direction: column;">
        <Navbar
          theme={this.theme}
          toggleTheme={() => this._toggleTheme()}
          openWaitlist={() => this._openWaitlist()}
          activeSection=""
          activePage="/about"
        />

        <main style="flex: 1;">
          {/* Mission Hero */}
          <section style="padding: 90px 29px 72px; background: var(--brand-navy-dark); text-align: center; position: relative; overflow: hidden;">
            <div style="max-width: 720px; margin: 0 auto; position: relative; z-index: 2;">
              <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 18px;">About</span>
              <h1 style="font-size: clamp(32px, 5.5vw, 56px); font-weight: 900; color: #fff; line-height: 1.05; letter-spacing: -0.04em; margin-bottom: 22px;">We're building the operating system for modern retail</h1>
              <p style="font-size: 17px; color: #9ca3af; line-height: 1.65; max-width: 560px; margin: 0 auto;">Alpine is how thousands of retail businesses will manage their POS, inventory, and finances — from a single kiosk to a global chain.</p>
            </div>
            <div style="position: absolute; top: -90px; left: 50%; transform: translateX(-50%); width: 700px; height: 500px; background: radial-gradient(circle, rgba(45, 122, 58, 0.07) 0%, transparent 70%); pointer-events: none;"></div>
          </section>

          {/* Stats */}
          <section style="padding: 54px 29px; background: var(--brand-bg-page); border-bottom: 1px solid var(--brand-border);">
            <div style="max-width: 720px; margin: 0 auto; display: flex; justify-content: center; gap: 72px; flex-wrap: wrap;">
              {this._stats().map((s: any) => (
                <div key={s.label} style="text-align: center;">
                  <div style="font-size: 29px; font-weight: 900; color: var(--brand-navy); letter-spacing: -0.04em; margin-bottom: 5px;">{s.stat}</div>
                  <div style="font-size: 12px; font-weight: 600; color: var(--brand-text-muted); text-transform: uppercase; letter-spacing: 0.08em;">{s.label}</div>
                </div>
              ))}
            </div>
          </section>

          {/* The Story */}
          <section style="padding: 72px 29px; background: var(--brand-bg-page);">
            <div style="max-width: 820px; margin: 0 auto;">
              <div class="grid two-col" style="align-items: start; gap: 72px;">
                <div>
                  <span style="display: inline-block; font-size: 11px; font-weight: 800; color: var(--brand-green); text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 14px;">The Story</span>
                  <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 800; color: var(--brand-navy); line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 22px;">Built by Kibologic in 2026</h2>
                  <p style="font-size: 15px; color: var(--brand-text-body); line-height: 1.75; margin-bottom: 18px;">Alpine is built by Kibologic — a software company building global commerce infrastructure. We've seen the gaps that generic ERP systems leave in modern markets, and we're building the platform we always wished existed.</p>
                  <p style="font-size: 15px; color: var(--brand-text-body); line-height: 1.75; margin-bottom: 18px;">We started with a focus on African retail markets, where connectivity is inconsistent, fiscal compliance requirements are evolving rapidly, and most existing software wasn't built for local realities. But Alpine is designed to be globally available — the same product that serves a market stall in Lilongwe serves a retail chain in London.</p>
                  <p style="font-size: 15px; color: var(--brand-text-body); line-height: 1.75;">We focus on reliability first. Alpine works offline, handles international compliance requirements, and scales from a single kiosk to a global operation.</p>
                </div>
                <div style="display: flex; flex-direction: column; gap: 14px;">
                  {this._values().map((val: any) => (
                    <div key={val.title} style="background: var(--brand-bg-subtle); border: 1px solid var(--brand-border); border-radius: 16px; padding: 24px;">
                      <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--brand-green); margin-bottom: 13px;"></div>
                      <div style="font-size: 14px; font-weight: 800; color: var(--brand-navy); margin-bottom: 7px;">{val.title}</div>
                      <div style="font-size: 13px; color: var(--brand-text-body); line-height: 1.65;">{val.desc}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>

          {/* GitHub + CTA */}
          <section style="padding: 72px 29px; background: var(--brand-bg-subtle);">
            <div style="max-width: 820px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 36px;">
              <div style="max-width: 500px;">
                <h2 style="font-size: clamp(20px, 3.5vw, 30px); font-weight: 800; color: var(--brand-navy); letter-spacing: -0.03em; margin-bottom: 11px;">We build in the open</h2>
                <p style="font-size: 14px; color: var(--brand-text-body); line-height: 1.65;">This website's source code is open on GitHub. We welcome bug reports, suggestions, and community feedback.</p>
              </div>
              <div style="display: flex; gap: 13px; flex-wrap: wrap;">
                <a href="https://github.com/kibologic/alpine-website" target="_blank" style="display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; background: var(--brand-bg-inverse); color: var(--brand-text-inverse); border-radius: 899px; font-size: 13px; font-weight: 700; text-decoration: none; transition: all 0.2s;" onmouseover={(e: any) => { e.currentTarget.style.opacity = '0.88'; e.currentTarget.style.transform = 'translateY(-1px)'; }} onmouseout={(e: any) => { e.currentTarget.style.opacity = '1'; e.currentTarget.style.transform = 'translateY(0)'; }}>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                  View on GitHub
                </a>
                <button onclick={() => this._openWaitlist()} class="btn btn-primary">Join Waitlist</button>
              </div>
            </div>
          </section>
        </main>

        <Footer />

        <WaitlistModal
          isOpen={this.waitlistOpen}
          theme={this.theme}
          onClose={() => this._closeWaitlist()}
        />
      </div>
    );
  }
}
