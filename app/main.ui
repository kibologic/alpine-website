import { mount, Signal, createElement, Fragment } from '@swissjs/core';
import { LandingPage } from './pages/LandingPage.uix';
import { FeaturesPage } from './pages/FeaturesPage.uix';
import { PricingPage } from './pages/PricingPage.uix';
import { IntegrationsPage } from './pages/IntegrationsPage.uix';
import { AboutPage } from './pages/AboutPage.uix';
import { ChangelogPage } from './pages/ChangelogPage.uix';

globalThis.createElement = createElement;
globalThis.Fragment = Fragment;

const route$ = new Signal(window.location.pathname);

window.addEventListener('popstate', () => {
  route$.value = window.location.pathname;
  window.scrollTo({ top: 0, behavior: 'smooth' });
});

// Global internal link interceptor
document.addEventListener('click', (e: any) => {
  const link = e.target.closest('a');
  if (link && link.href && link.href.startsWith(window.location.origin) && !link.target && !e.metaKey && !e.ctrlKey) {
    const path = link.getAttribute('href');
    if (path && path.startsWith('/') && !path.includes('#')) {
      e.preventDefault();
      history.pushState(null, '', path);
      route$.value = path;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  }
});

function Router() {
  const path = route$.value;
  if (path === '/features') return <FeaturesPage />;
  if (path === '/pricing') return <PricingPage />;
  if (path === '/integrations') return <IntegrationsPage />;
  if (path === '/about') return <AboutPage />;
  if (path === '/changelog') return <ChangelogPage />;
  return <LandingPage />;
}

mount(Router, document.getElementById('app'));
